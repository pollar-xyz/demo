{
  "name": "demo-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3060",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:pull": "rm -rf node_modules/@pollar && yalc add @pollar/react @pollar/core @pollar/stellar-wallets-kit-adapter @pollar/privy-adapter @pollar/accesly-adapter && pnpm add @noble/hashes",
    "pull": "pnpm remove @noble/hashes && pnpm add @pollar/react@latest @pollar/core@latest @pollar/privy-adapter@latest @pollar/accesly-adapter@latest"
  },
  "dependencies": {
    "@accesly/core": "1.8.0",
    "@accesly/react": "1.8.0",
    "@creit.tech/stellar-wallets-kit": "^2.3.0",
    "@noble/hashes": "^2.2.0",
    "@pollar/accesly-adapter": "file:.yalc/@pollar/accesly-adapter",
    "@pollar/core": "file:.yalc/@pollar/core",
    "@pollar/privy-adapter": "file:.yalc/@pollar/privy-adapter",
    "@pollar/react": "file:.yalc/@pollar/react",
    "@pollar/stellar-wallets-kit-adapter": "file:.yalc/@pollar/stellar-wallets-kit-adapter",
    "@privy-io/react-auth": "3.32.0",
    "@stellar/stellar-sdk": "^15.0.0",
    "next": "16.2.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
