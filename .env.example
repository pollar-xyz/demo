# ── Neko Protocol proxy (server-only) ────────────────────────────────────────
# The Neko proxy is SERVER-ONLY: every request must carry a secret `x-server-code`
# header, and it must NEVER be called from the browser (a browser can't keep a
# secret). This demo's Next.js API routes (app/api/neko/*) hold the code and
# forward to the proxy; the browser only ever talks to those same-origin routes.
#
# NOTE: do NOT prefix these with NEXT_PUBLIC_ — that would inline the secret into
# the client bundle. They are read at runtime on the server only.

# Base URL of the Neko proxy (no trailing slash).
NEKO_PROXY_BASE_URL=https://neko-protocol-proxy.pollar.dev

# Secret server code sent upstream as the `x-server-code` header.
NEKO_SERVER_CODE=replace-with-your-neko-server-code

# Optional: upstream request timeout in milliseconds (default 15000).
# NEKO_PROXY_TIMEOUT_MS=15000

# Base URL of Neko's PUBLIC app (no trailing slash). Required: the audit
# endpoint (/api/audit) is forwarded here, with NO x-server-code secret —
# unlike the server-only proxy above.
NEKO_APP_BASE_URL=https://app.nekoprotocol.xyz

# ── Neko Protocol passcode (server-only) ─────────────────────────────────────
# Gates the entire Neko Protocol section. The section is LOCKED by default:
# every /neko route 404s and the Neko nav group / landing cards are hidden.
# To unlock it, visit any URL with ?neko=<passcode> matching this value — the
# middleware validates it server-side and sets an unlock cookie for the session.
#
# Do NOT prefix with NEXT_PUBLIC_: the passcode is compared on the server only
# and is never shipped to the browser. Leave unset to keep the section
# permanently locked (no passcode can unlock it).
NEKO_PASSCODE=replace-with-your-neko-passcode

# ── Accesly passcode (server-only) ───────────────────────────────────────────
# Gates the entire Accesly section. The section is LOCKED by default:
# every /accesly route 404s and the Accesly nav group is hidden.
# To unlock it, visit any URL with ?accesly=<passcode> matching this value —
# the middleware validates it server-side and sets an unlock cookie.
ACCESLY_PASSCODE=replace-with-your-accesly-passcode

# ── Privy (public) ───────────────────────────────────────────────────────────
# Powers the /privy tab: Google + email login and a self-custodial Stellar
# embedded wallet that signs USDC payments client-side.
#
# The App ID is PUBLIC — it identifies the Privy app in the browser, so the
# NEXT_PUBLIC_ prefix is intentional. Configure the allowed login methods
# (email, Google), the Google OAuth provider, and your allowed domains in the
# Privy dashboard (https://dashboard.privy.io). No app secret is needed: the
# Stellar wallet is created and signs entirely on the client.
NEXT_PUBLIC_PRIVY_APP_ID=replace-with-your-privy-app-id
